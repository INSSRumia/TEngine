    "dotnet.defaultSolution": "UnityProject/UnityProject.sln",
    "files.exclude": {
        "**/.git": true,
        ".vsconfig": true,
        "**/*.png": true,
        "**/*.asset": true,
        "**/*.tss": true,
        "**/*.dll": true,
        "**/*.meta": true,
