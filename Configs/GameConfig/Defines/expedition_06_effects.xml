<module name="Gameplay.Expedition">
    <!-- 远征 Effect 基类。summary 用于结算摘要/调试展示。 -->
    <bean name="ExpeditionEffectConfig" valueType="false" sep=",">
        <!-- 支持命名 token，例如 {money}、{count}、{marble_name}。 -->
        <var name="summary" type="string" />
    </bean>

    <!-- 修改远征 money。真实强度由 money.reward_tier + 当前远征 reward profile 解析，增减方向由 operation 决定。 -->
    <bean name="AddMoneyEffectConfig" alias="add_money" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="operation" type="Gameplay.EnumOperation" />
        <var name="tier" type="EnumExpeditionRewardTier" />
        <var name="value" type="int" />
    </bean>

    <!-- 增减玩家当前远征队伍中所有 Marble 的经验。真实数值由 exp.reward_tier 解析。 -->
    <bean name="AddPlayerMarbleExpEffectConfig" alias="add_player_marble_exp" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="tier" type="EnumExpeditionRewardTier" />
        <var name="value" type="int" />
    </bean>

    <!-- 修改玩家当前远征队伍中所有存活 Marble 的 HP。真实强度由 hp.reward_tier 解析，增减方向由 operation 决定。 -->
    <bean name="AddPlayerMarbleHpEffectConfig" alias="add_player_marble_hp" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="operation" type="Gameplay.EnumOperation" />
        <var name="tier" type="EnumExpeditionRewardTier" />
        <var name="value" type="int" />
    </bean>

    <!-- 往玩家当前远征队伍中添加指定数量的 Marble。数量与 Marble 候选都由 marble_count.reward_tier 解析。 -->
    <bean name="AddPlayerMarbleEffectConfig" alias="add_player_marble" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="marble_count_tier" type="EnumExpeditionRewardTier" />
        <var name="marble_count_value" type="int" />
        <var name="marble_type_tier" type="EnumExpeditionRewardTier" />
        <var name="marble_type_value" type="Gameplay.Combat.MarbleSpawnConfig" />
    </bean>

    <!-- 改变当前远征环境，并按环境切换规则更新环境来源随机事件池。 -->
    <bean name="ChangeEnvironmentEffectConfig" alias="change_environment" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="target_environment_config_id" type="string" />
    </bean>

    <!-- 在当前节点结算后，延迟若干个节点再插入一个临时 event/combat 节点。passed_node_count 使用 1 表示“下一个节点就是插入节点”。 -->
    <bean name="DelayInsertNodeEffectConfig" alias="delay_insert_node" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <!-- 使用 1 基语义：1 = 下一个节点插入，2 = 下下个节点插入。 -->
        <var name="passed_node_count" type="int" />
        <!-- 只允许使用 event / combat；event 时 id 表示 event_config_id，combat 时 id 表示 combat_encounter_config_id。 -->
        <var name="node_type" type="EnumExpeditionNodeType" />
        <var name="id" type="string" />
    </bean>
</module>
