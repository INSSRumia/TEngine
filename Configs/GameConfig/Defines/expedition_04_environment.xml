<module name="Gameplay.Expedition">
    <!-- 随机事件池条目。同一池内抽中后会从该池本次运行的剩余条目中移除。 -->
    <bean name="ExpeditionRandomEventPoolEntryConfig" valueType="false" sep=",">
        <var name="event_config_id" type="string" />
        <!-- 抽取权重。小于等于 0 的条目不会参与有效抽取。 -->
        <var name="weight" type="int" />
    </bean>

    <!-- 随机事件池配置。池是候选库，不是节点；走到 RandomEvent 节点时才会抽取。 -->
    <bean name="ExpeditionRandomEventPoolConfig" valueType="false" sep=",">
        <var name="random_event_pool_config_id" type="string" />
        <var name="name" type="string" />
        <var name="description" type="string" />
        <!-- 池内事件条目。同一 Event 可出现在不同池中，并可分别被抽到。 -->
        <var name="lst_event" type="list, ExpeditionRandomEventPoolEntryConfig" />
    </bean>

    <!-- 环境提供的场地候选。真正的场地配置归 Combat 命名空间管理。 -->
    <bean name="ExpeditionEnvironmentBattlefieldConfig" valueType="false" sep=",">
        <var name="battlefield_config_id" type="string" />
        <!-- 环境随机选择场地时的权重。场地选择是放回的，不会从候选中移除。 -->
        <var name="weight" type="int" />
    </bean>

    <!-- 环境提供的动态敌人候选。环境只负责敌人类型候选与 camp 配置来源，不负责本场数量和最终等级。 -->
    <bean name="ExpeditionEnvironmentEnemyCandidateConfig" valueType="false" sep=",">
        <!-- 运行时会使用其中的 marble_config_id 与 camp_config_id 作为类型基础；若该候选被动态敌人组选中，其 level 会被 enemy profile 解析结果覆盖。 -->
        <var name="marble_spawn_config" type="Gameplay.Combat.MarbleSpawnConfig" />
        <!-- 环境随机选择动态敌人类型时的权重。敌人类型抽取是放回的。 -->
        <var name="weight" type="int" />
    </bean>

    <!-- 远征环境。当前只影响随机事件池和场地候选，不实现环境 Buff。 -->
    <bean name="ExpeditionEnvironmentConfig" valueType="false" sep=",">
        <var name="environment_config_id" type="string" />
        <var name="name" type="string" />
        <var name="description" type="string" />
        <!-- 进入该环境时激活的随机事件池；离开环境时移除这些环境来源的池。 -->
        <var name="lst_random_event_pool_config_id" type="list, string" />
        <!-- Combat 未显式配置场地时，从当前环境的该列表中按权重抽取。 -->
        <var name="lst_battlefield" type="list, ExpeditionEnvironmentBattlefieldConfig" />
        <!-- Combat 遭遇存在动态敌人组时，从当前环境的该列表中按权重抽取敌人类型。 -->
        <var name="lst_enemy_candidate" type="list, ExpeditionEnvironmentEnemyCandidateConfig" />
    </bean>
</module>
