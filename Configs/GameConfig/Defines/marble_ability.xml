<module name="Gameplay.Combat">
    <enum name="EnumCombineType">
        <var name="Combine" alias="combine" value="0" />
        <var name="Override" alias="override" value="1" />
    </enum>
    <!--
    ============================================================
    Marble Ability 配置基类
    ============================================================
    用于 MarbleLevelConfig.lst_ability 中的可选 Ability 配置。
    -->
    <bean name="MarbleAbilityConfig" valueType="false" sep=",">
        <var name="priority" type="int" />
        <var name="combine_type" type="EnumCombineType" />
    </bean>

    <!--
    ============================================================
    MarbleCloseToTargetAbility 配置
    ============================================================
    可选 Ability：当 Marble 与目标距离小于 CloseDistance 时停止移动。
    -->
    <bean name="MarbleCloseToTargetAbilityConfig" alias="close_to_target" parent="MarbleAbilityConfig" valueType="false" sep=",">
        <!-- # 触发停止移动的判定距离-->
        <var name="close_distance" type="float" />
        <var name="target_speed" type="float" />
        <var name="acceleration" type="float" />
    </bean>

    <!--
    ============================================================
    MarbleDefaultRotateAbility 配置
    ============================================================
    可选 Ability：默认旋转能力。
    -->
    <bean name="MarbleDefaultRotateAbilityConfig" alias="default_rotate" parent="MarbleAbilityConfig" valueType="false" sep=",">
        <var name="target_angular_speed" type="float" />
        <var name="angular_acceleration" type="float" />
    </bean>

    <!--
    ============================================================
    MarbleDashAbility 配置
    ============================================================
    定时冲刺能力：激活期内持续提高目标速度和加速度。
    -->
    <bean name="MarbleDashAbilityConfig" alias="dash" parent="MarbleAbilityConfig" valueType="false" sep=",">
        <var name="target_speed" type="float" />
        <var name="acceleration" type="float" />
        <var name="lock_direction_on_activate" type="bool" />
        <var name="timing" type="AbilityTimingConfig" />
    </bean>

    <!--
    ============================================================
    MarbleFaceTargetDirectionAbility 配置
    ============================================================
    定时朝向目标能力：在激活期间持续让 Marble 的指定方向转向敌人。
    -->
    <bean name="MarbleFaceTargetDirectionAbilityConfig" alias="face_target_direction" parent="MarbleAbilityConfig" valueType="false" sep=",">
        <var name="target_local_direction" type="vector2" />
        <var name="target_angular_speed" type="float" />
        <var name="angular_acceleration" type="float" />
        <var name="timing" type="AbilityTimingConfig" />
    </bean>
</module>
