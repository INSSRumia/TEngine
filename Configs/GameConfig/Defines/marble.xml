<module name="Gameplay.Combat">


    <!--
    ============================================================
    Marble 等级配置
    ============================================================
    -->
    <bean name="MarbleLevelConfig" valueType="false" sep=",">
        <var name="level" type="int" />
        <var name="upgrade_exp" type="int" />

        <var name="attack" type="int" />
        <var name="hp" type="int" />
        <var name="shield" type="int" />
        <var name="defense" type="int" />

        <var name="speed" type="float" />
        <var name="mass" type="float" />
        <var name="scale" type="float" />
        <var name="lst_equipment" type="list, EquipAttachConfig" />

        <!-- # 扩展玩法 Ability 配置列表；固定运行骨架参数继续保留为显式字段 -->
        <var name="lst_ability" type="list, MarbleAbilityConfig" />
    </bean>

    <!--
    ============================================================
    Marble 配置入口
    ============================================================
    -->
    <bean name="MarbleConfig" valueType="false" sep=",">
        <var name="config_id" type="string" />
        <var name="name" type="string" />
        <var name="lst_level_config" type="list, MarbleLevelConfig" />
    </bean>

    <table name="TbMarble" value="MarbleConfig" input="marble.xlsx" index="config_id"/>
</module>