<module name="Gameplay.Combat">
    <enum name="EnumCombineType">
        <var name="Combine" alias="combine" value="0" />
        <var name="Override" alias="override" value="1" />
    </enum>
    <!--
    ============================================================
    Marble Ability 配置基类
    ============================================================
    用于 MarbleLevelConfig.lst_ability 中的可选 Ability 配置。
    -->
    <bean name="MarbleAbilityConfig" valueType="false" sep=",">
        <var name="priority" type="int" />
        <var name="combine_type" type="EnumCombineType" />
    </bean>

    <!--
    ============================================================
    MarbleCloseToTargetAbility 配置
    ============================================================
    可选 Ability：当 Marble 与目标距离小于 CloseDistance 时停止移动。
    -->
    <bean name="MarbleCloseToTargetAbilityConfig" alias="close_to_target" parent="MarbleAbilityConfig" valueType="false" sep=",">
        <!-- # 触发停止移动的判定距离-->
        <var name="close_distance" type="float" />
        <var name="target_speed" type="float" />
        <var name="acceleration" type="float" />
    </bean>

    <!--
    ============================================================
    MarbleDefaultRotateAbility 配置
    ============================================================
    可选 Ability：默认旋转能力。
    -->
    <bean name="MarbleDefaultRotateAbilityConfig" alias="default_rotate" parent="MarbleAbilityConfig" valueType="false" sep=",">
        <var name="target_angular_speed" type="float" />
        <var name="angular_acceleration" type="float" />
    </bean>

    <!--
    ============================================================
    Marble 等级配置
    ============================================================
    -->
    <bean name="MarbleLevelConfig" valueType="false" sep=",">
        <var name="level" type="int" />
        <var name="upgrade_exp" type="int" />

        <var name="attack" type="int" />
        <var name="hp" type="int" />
        <var name="shield" type="int" />
        <var name="defense" type="int" />

        <var name="speed" type="float" />
        <var name="mass" type="float" />
        <var name="scale" type="float" />
        <var name="lst_equipment" type="list, EquipAttachConfig" />

        <!--
        ============================================================
        可选 Ability 配置列表
        ============================================================
        Core 文件夹中的 Ability 由 MarbleFactory.AttachDefaultAbilities() 硬编码添加，
        无需在此配置。

        此列表仅用于配置可选 Ability 的参数。
        当前支持的类型：
          - MarbleCloseToTarget : MarbleCloseToTargetAbility，需要 close_distance 参数
        -->
        <var name="lst_ability" type="list, MarbleAbilityConfig" />
    </bean>

    <!--
    ============================================================
    Marble 配置入口
    ============================================================
    -->
    <bean name="MarbleConfig" valueType="false" sep=",">
        <var name="config_id" type="string" />
        <var name="name" type="string" />
        <var name="lst_level_config" type="list, MarbleLevelConfig" />
    </bean>

    <table name="TbMarble" value="MarbleConfig" input="marble.xlsx" index="config_id"/>
</module>