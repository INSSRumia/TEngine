<module name="Gameplay.Combat">
    <enum name="EnumEquipmentSlot">
        <var name="Top" alias="top" value="0" />
        <var name="Left" alias="left" value="1" />
        <var name="Right" alias="right" value="2" />
        <var name="Bottom" alias="bottom" value="3" />
        <var name="Middle" alias="middle" value="4" />
    </enum>

    <bean name="EquipAttachConfig" valueType="false" sep=",">
        <var name="config_id" type="string" />
        <var name="level" type="int" />
        <!-- # 装备位于marble的哪个位置
        # 0: top, 1: left, 2: right, 3: bottom 4: middle -->
        <var name="slot" type="EnumEquipmentSlot" />
    </bean>

    <bean name="EquipmentConfig" valueType="false" sep=",">
        <var name="config_id" type="string" />
        <var name="lst_level_config" type="list, EquipmentLevelConfig" />
    </bean>

    <!--
    ============================================================
    Equipment Ability 配置基类
    ============================================================
    用于 EquipmentLevelConfig.lst_ability 中的可选 Ability 配置。
    -->
    <bean name="EquipmentAbilityConfig" valueType="false" sep=",">
        <var name="priority" type="int" />
    </bean>

    <!--
    ============================================================
    SwordCollisionAttackAbility 配置
    ============================================================
    剑碰撞攻击 Ability：碰撞时根据相对速度计算伤害。
    -->
    <bean name="SwordCollisionAttackAbilityConfig" alias="sword_collision_attack" parent="EquipmentAbilityConfig" valueType="false" sep=",">
    </bean>

    <!--
    ============================================================
    ArmorReduceDamageAbility 配置
    ============================================================
    护甲减伤 Ability：减伤后剩余伤害转发给 OwnerMarble。
    -->
    <bean name="ArmorReduceDamageAbilityConfig" alias="armor_reduce_damage" parent="EquipmentAbilityConfig" valueType="false" sep=",">
    </bean>

    <!--
    ============================================================
    ArmorAbsorbDamageAbility 配置
    ============================================================
    护甲吸收 Ability：护甲自身扣血，被破坏前不扣 Marble 血量。
    -->
    <bean name="ArmorAbsorbDamageAbilityConfig" alias="armor_absorb_damage" parent="EquipmentAbilityConfig" valueType="false" sep=",">
    </bean>

    <!--
    ============================================================
    EquipmentLevelConfig 基类
    ============================================================
    -->
    <bean name="EquipmentLevelConfig" alias="equip" valueType="false" sep=",">
        <var name="level" type="int" />
        <var name="name" type="string" />

        <!--
        ============================================================
        可选 Ability 配置列表
        ============================================================
        Core 文件夹中的 Ability 由 EquipmentFactory.AttachDefaultAbilities() 硬编码添加，
        无需在此配置。

        此列表用于配置可选 Ability，或额外覆盖/替换 Core Ability。
        当前支持的类型：
          - ArmorReduceDamage : 护甲减伤
          - ArmorAbsorbDamage : 护甲吸收
        -->
        <var name="lst_ability" type="list, EquipmentAbilityConfig" />
    </bean>

    <bean name="ArmorLevelConfig" alias="armor" parent="EquipmentLevelConfig" valueType="false" sep=",">
        <!-- 
        # 如果装备血量大于0，则说明装备会被破坏，在血量清空前不会扣marble血量
        # 如果装备血量小于等于0，则装备不会被破坏，只提供defense减伤效果
        # 例如头盔不会被破坏，只会减伤
        # 盾牌会被破坏，在被破坏前不会扣marble血量-->
        <var name="hp" type="int" />
        <var name="defense" type="int" />
    </bean>

    <bean name="WeaponLevelConfig" alias="weapon" parent="EquipmentLevelConfig" valueType="false" sep=",">
        <!-- # 武器攻击力，如果attack为null，则使用marble的attack -->
        <var name="attack" type="int?" />
        <!-- # 是否通过速度计算伤害,如果是，则伤害=速度差*系数*attack，否则伤害=attack -->
        <var name="is_damage_by_velocity" type="bool" />
        <var name="cooldown" type="float" />
    </bean>

    <bean name="SwordLevelConfig" alias="sword" parent="WeaponLevelConfig" valueType="false" sep=",">
    </bean>

    <bean name="BowLevelConfig" alias="bow" parent="WeaponLevelConfig" valueType="false" sep=",">
        <!-- # 弓的装填时间 -->
        <!-- # <var name="cooldown" type="float" /> -->
        <!-- # 弓的旋转速度，每秒旋转多少度 -->
        <var name="rotate_speed" type="float" />
        <!-- # 0: 连射 1： 散射  -->
        <var name="shoot_type" type="int" />
        <var name="arrow_count" type="int" />
        <!-- # 连射时的射击间隔，不能超过cooldown
        # 如果填0，所有箭矢都会叠在一起 -->
        <var name="arrow_interval" type="float" />
        <!-- # 散射时的箭矢角度差距，会以弓当前的方向为中心，向左右两边分布
        # 例如填5度，射出3根箭矢，则每根箭矢的角度差距为5度，第一根箭矢的角度为0度，第二根箭矢的角度为5度，第三根箭矢的角度为-5度
        # 如果填0度，则所有箭矢都会叠在一起
        # 无论如何瞄准的方向都会射出一根箭矢，如果箭矢数量为偶数，则左右两边的的箭矢数量不会相等 -->
        <var name="arrow_angle_step" type="float" />
        <!-- # 瞄准角度，设弓指向目标的向量为a, 弓的前方方向为b, 则当a与b的夹角小于aim_angle时，弓允许发射。 -->
        <var name="aim_angle" type="float" />
    </bean>

    <table name="TbEquipment" value="EquipmentConfig" input="equip.xlsx" index="config_id"/>

</module>