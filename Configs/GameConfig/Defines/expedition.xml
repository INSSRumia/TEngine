<module name="Gameplay.Expedition">
    <!-- 远征节点类型。Event 使用固定事件；RandomEvent 从当前激活随机事件池抽事件；Combat 进入战斗遭遇。 -->
    <enum name="EnumExpeditionNodeType">
        <var name="None" alias="none" value="0" />
        <var name="Event" alias="event" value="1" />
        <var name="Combat" alias="combat" value="2" />
        <var name="RandomEvent" alias="random_event" value="3" />
    </enum>

    <!-- 节点出口策略。出口逻辑属于 Node，不属于可复用 Event。 -->
    <enum name="EnumExpeditionRoutePolicy">
        <var name="FixedNext" alias="fixed_next" value="0" />
        <var name="BySelectedOption" alias="by_selected_option" value="1" />
        <var name="ByConditions" alias="by_conditions" value="2" />
    </enum>

    <!-- 远征路线条件基类。summary 只用于策划/调试说明，不参与运行时判断。 -->
    <bean name="ExpeditionConditionConfig" valueType="false" sep=",">
        <var name="summary" type="string" />
    </bean>

    <!-- 判断远征黑板中是否拥有指定 flag。 -->
    <bean name="HasFlagConditionConfig" alias="has_flag" parent="ExpeditionConditionConfig" valueType="false" sep=",">
        <var name="flag_id" type="string" />
    </bean>

    <!-- 判断远征黑板中是否拥有指定 item。当前 item 只作为远征黑板标记使用。 -->
    <bean name="HasItemConditionConfig" alias="has_item" parent="ExpeditionConditionConfig" valueType="false" sep=",">
        <var name="item_id" type="string" />
    </bean>

    <!-- 判断本次远征中是否曾经选择过指定 option_id。 -->
    <bean name="HasChosenOptionConditionConfig" alias="has_chosen_option" parent="ExpeditionConditionConfig" valueType="false" sep=",">
        <var name="option_id" type="string" />
    </bean>

    <!-- 判断远征黑板计数器是否大于等于 min_value。 -->
    <bean name="CounterAtLeastConditionConfig" alias="counter_at_least" parent="ExpeditionConditionConfig" valueType="false" sep=",">
        <var name="counter_id" type="string" />
        <var name="min_value" type="int" />
    </bean>

    <!-- 与条件。conditions 中所有子条件都满足时才满足。空列表按不满足处理。 -->
    <bean name="AndConditionConfig" alias="and" parent="ExpeditionConditionConfig" valueType="false" sep=",">
        <var name="conditions" type="list, ExpeditionConditionConfig" />
    </bean>

    <!-- 或条件。conditions 中任意子条件满足时即满足。空列表按不满足处理。 -->
    <bean name="OrConditionConfig" alias="or" parent="ExpeditionConditionConfig" valueType="false" sep=",">
        <var name="conditions" type="list, ExpeditionConditionConfig" />
    </bean>

    <!-- 非条件。对单个 condition 的结果取反。 -->
    <bean name="NotConditionConfig" alias="not" parent="ExpeditionConditionConfig" valueType="false" sep=",">
        <var name="condition" type="ExpeditionConditionConfig" />
    </bean>

    <!-- Node 的一个出口。FixedNext/ByConditions 会在候选出口中选优先级最高者。 -->
    <bean name="ExpeditionNodeTransitionConfig" valueType="false" sep=",">
        <!-- 出口业务 Id，只在当前 Node 内用于 option_routes 引用和调试显示。 -->
        <var name="transition_id" type="string" />
        <!-- 目标 Node 的配置 Id。为空表示该 Node 可作为叶子节点结束推进。 -->
        <var name="target_node_config_id" type="string" />
        <!-- 出口优先级。数值越大优先级越高。 -->
        <var name="priority" type="int" />
        <!-- ByConditions 策略下使用的条件列表；所有条件满足时该出口命中。 -->
        <var name="conditions" type="list, ExpeditionConditionConfig" />
    </bean>

    <!-- BySelectedOption 策略使用的 option_id 到 transition_id 映射。 -->
    <bean name="ExpeditionOptionRouteConfig" valueType="false" sep=",">
        <var name="option_id" type="string" />
        <var name="transition_id" type="string" />
    </bean>

    <!-- 远征路线节点配置。Event 只提供内容，出口由当前 Node 的 route_policy 决定。 -->
    <bean name="ExpeditionRouteNodeConfig" valueType="false" sep=",">
        <var name="node_config_id" type="string" />
        <var name="node_type" type="EnumExpeditionNodeType" />
        <!-- Event 节点使用的固定事件；RandomEvent 节点通常不填此字段。 -->
        <var name="event_config_id" type="string" />
        <!-- Combat 节点使用的遭遇配置。 -->
        <var name="combat_encounter_config_id" type="string" />
        <var name="route_policy" type="EnumExpeditionRoutePolicy" />
        <var name="transitions" type="list, ExpeditionNodeTransitionConfig" />
        <var name="option_routes" type="list, ExpeditionOptionRouteConfig" />
    </bean>

    <!-- 随机事件池条目。同一池内抽中后会从该池本次运行的剩余条目中移除。 -->
    <bean name="ExpeditionRandomEventPoolEntryConfig" valueType="false" sep=",">
        <var name="event_config_id" type="string" />
        <!-- 抽取权重。小于等于 0 的条目不会参与有效抽取。 -->
        <var name="weight" type="int" />
    </bean>

    <!-- 随机事件池配置。池是候选库，不是节点；走到 RandomEvent 节点时才会抽取。 -->
    <bean name="ExpeditionRandomEventPoolConfig" valueType="false" sep=",">
        <var name="random_event_pool_config_id" type="string" />
        <var name="name" type="string" />
        <var name="description" type="string" />
        <!-- 池内事件条目。同一 Event 可出现在不同池中，并可分别被抽到。 -->
        <var name="lst_event" type="list, ExpeditionRandomEventPoolEntryConfig" />
    </bean>

    <!-- 环境提供的场地候选。真正的场地配置归 Combat 命名空间管理。 -->
    <bean name="ExpeditionEnvironmentBattlefieldConfig" valueType="false" sep=",">
        <var name="battlefield_config_id" type="string" />
        <!-- 环境随机选择场地时的权重。场地选择是放回的，不会从候选中移除。 -->
        <var name="weight" type="int" />
    </bean>

    <!-- 远征环境。当前只影响随机事件池和场地候选，不实现环境 Buff。 -->
    <bean name="ExpeditionEnvironmentConfig" valueType="false" sep=",">
        <var name="environment_config_id" type="string" />
        <var name="name" type="string" />
        <var name="description" type="string" />
        <!-- 进入该环境时激活的随机事件池；离开环境时移除这些环境来源的池。 -->
        <var name="lst_random_event_pool_config_id" type="list, string" />
        <!-- Combat 未显式配置场地时，从当前环境的该列表中按权重抽取。 -->
        <var name="lst_battlefield" type="list, ExpeditionEnvironmentBattlefieldConfig" />
    </bean>

    <!-- 远征主配置。一次 ExpeditionConfig 对应一条可进入的远征路线。 -->
    <bean name="ExpeditionConfig" valueType="false" sep=",">
        <var name="expedition_config_id" type="string" />
        <var name="name" type="string" />
        <var name="description" type="string" />
        <!-- 开始远征时进入的环境，会激活该环境的随机事件池。 -->
        <var name="initial_environment_config_id" type="string" />
        <!-- 远征基础随机事件池，会在本次远征期间持续存在，不随环境切换移除。 -->
        <var name="lst_random_event_pool_config_id" type="list, string" />
        <var name="route" type="list, ExpeditionRouteNodeConfig" />
    </bean>

    <!-- 远征 Effect 基类。summary 用于结算摘要/调试展示。 -->
    <bean name="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="summary" type="string" />
    </bean>

    <!-- 增减远征 money。正数增加，负数扣除。 -->
    <bean name="AddMoneyEffectConfig" alias="add_money" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="money_delta" type="int" />
    </bean>

    <!-- 增减玩家当前远征队伍中所有 Marble 的经验。 -->
    <bean name="AddPlayerMarbleExpEffectConfig" alias="add_player_marble_exp" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="exp_delta" type="int" />
    </bean>

    <!-- 增减玩家当前远征队伍中所有存活 Marble 的 HP。 -->
    <bean name="AddPlayerMarbleHpEffectConfig" alias="add_player_marble_hp" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="hp_delta" type="int" />
    </bean>

    <!-- 往玩家当前远征队伍中添加指定数量的 Marble。新增 Marble 会参与后续 Combat，并在远征结算时回写到局外队伍。 -->
    <bean name="AddPlayerMarbleEffectConfig" alias="add_player_marble" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="marble_spawn_config" type="Gameplay.Combat.MarbleSpawnConfig" />
        <var name="count" type="int" />
    </bean>

    <!-- 改变当前远征环境，并按环境切换规则更新环境来源随机事件池。 -->
    <bean name="ChangeEnvironmentEffectConfig" alias="change_environment" parent="ExpeditionEffectConfig" valueType="false" sep=",">
        <var name="target_environment_config_id" type="string" />
    </bean>

    <!-- 事件选项。选项执行 lst_effect，路线出口由所在 Node 决定。 -->
    <bean name="ExpeditionEventOptionConfig" valueType="false" sep=",">
        <var name="option_id" type="string" />
        <var name="title" type="string" />
        <var name="description" type="string" />
        <var name="lst_effect" type="list, ExpeditionEffectConfig" />
    </bean>

    <!-- 可复用事件内容。Event 不应该直接配置前往哪个 Node。 -->
    <bean name="ExpeditionEventConfig" valueType="false" sep=",">
        <var name="event_config_id" type="string" />
        <var name="title" type="string" />
        <var name="description" type="string" />
        <var name="options" type="list, ExpeditionEventOptionConfig" />
    </bean>

    <!-- 远征中的 Combat 遭遇配置。敌方 Marble 使用 Combat.MarbleSpawnConfig。 -->
    <bean name="ExpeditionCombatEncounterConfig" valueType="false" sep=",">
        <var name="combat_encounter_config_id" type="string" />
        <var name="title" type="string" />
        <var name="description" type="string" />
        <!-- Combat 胜利后执行的远征 Effect 列表。 -->
        <var name="lst_victory_effect" type="list, ExpeditionEffectConfig" />
        <!-- Combat 失败后执行的远征 Effect 列表。 -->
        <var name="lst_defeat_effect" type="list, ExpeditionEffectConfig" />
        <var name="enemy_marbles" type="list, Gameplay.Combat.MarbleSpawnConfig" />
        <!-- 可选显式场地。为空时从当前环境 lst_battlefield 中按权重选择。 -->
        <var name="battlefield_config_id" type="string" />
    </bean>

    <table name="TbExpedition" value="ExpeditionConfig" input="expedition.xlsx" index="expedition_config_id" />
    <table name="TbExpeditionEvent" value="ExpeditionEventConfig" input="expedition_event.xlsx" index="event_config_id" />
    <table name="TbExpeditionCombatEncounter" value="ExpeditionCombatEncounterConfig" input="expedition_combat_encounter.xlsx" index="combat_encounter_config_id" />
    <table name="TbExpeditionRandomEventPool" value="ExpeditionRandomEventPoolConfig" input="expedition_random_event_pool.xlsx" index="random_event_pool_config_id" />
    <table name="TbExpeditionEnvironment" value="ExpeditionEnvironmentConfig" input="expedition_environment.xlsx" index="environment_config_id" />
</module>
