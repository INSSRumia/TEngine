<module name="Gameplay.Combat">
    <!--
    ============================================================
    Ability Timing 配置基类
    ============================================================
    用于定时类 Ability 的持续、冷却与触发规则配置。
    -->
    <bean name="AbilityTimingConfig" valueType="false" sep=",">
    </bean>

    <!--
    ============================================================
    FixedAbilityTiming 配置
    ============================================================
    固定持续时间 + 固定冷却时间，可选自动循环触发。
    -->
    <bean name="FixedAbilityTimingConfig" alias="fixed_timing" parent="AbilityTimingConfig" valueType="false" sep=",">
        <var name="duration" type="float" />
        <var name="cooldown" type="float" />
        <var name="auto_activate" type="bool" />
    </bean>

    <!--
    ============================================================
    RandomRangeAbilityTiming 配置
    ============================================================
    每轮持续时间与冷却时间都在指定区间内随机取值，可选自动循环触发。
    -->
    <bean name="RandomRangeAbilityTimingConfig" alias="random_range_timing" parent="AbilityTimingConfig" valueType="false" sep=",">
        <var name="min_duration" type="float" />
        <var name="max_duration" type="float" />
        <var name="min_cooldown" type="float" />
        <var name="max_cooldown" type="float" />
        <var name="auto_activate" type="bool" />
    </bean>
</module>
